# Load with: set -a; . edge/.env; set +a (from repository root)
MAILBOX_SERVER_URL=http://localhost:5000
MAILBOX_SENSOR_PIN=11
MAILBOX_CAMERA=0
MAILBOX_MODEL_PATH=yolov8n.pt
MAILBOX_CONFIDENCE=0.5
MAILBOX_TIMEOUT=10
MAILBOX_SAVE_DIR=edge/captured
# Optional cloud analysis; empty key disables it.
GEMINI_API_KEY=
MAILBOX_GEMINI_MODEL=gemini-1.5-flash
